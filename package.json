{
  "name": "mog-core",
  "version": "1.0.0",
  "description": "A bytecode ISA and TypeScript toolchain for code shipped to constrained devices at runtime: structured control flow with no branch offsets, so a whole program's stack and call depth are decidable before it runs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamasseller/mog-core.git"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build:grammar": "peggy --format es -c pegconfig.json -o src/parser.js grammer.pegjs",
    "build": "npm run build:grammar && tsc",
    "test": "ts-node --project tsconfig.test.json test/run.ts",
    "test:types": "tsc --project tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "peggy": "^5.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
